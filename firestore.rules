rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Security Functions ──────────────────────────────
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Global Counter Collection ──────────────────────────────
    match /global_counter/{docId} {
      allow read: if true;
      allow create, update: if true; // allow counter increments
      allow delete: if isAdmin();
    }

    // ── User Profiles Collection ───────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Masail Q&A Collection ──────────────────────────────────
    match /masail_entries/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Aqaid Beliefs Collection ───────────────────────────────
    match /aqaid_entries/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Daily Content Collection ───────────────────────────────
    match /daily_content/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Community Events Collection ────────────────────────────
    match /events/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Broadcast Notifications Collection ─────────────────────
    match /notifications/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ── User Questions (Q&A) Collection ────────────────────────
    match /user_questions/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ── Password Reset OTPs Collection ──────────────────────────
    match /password_resets/{emailDoc} {
      allow read, write: if true;
    }
  }
}
