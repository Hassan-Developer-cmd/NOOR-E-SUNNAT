rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Security Functions ──────────────────────────────
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ── Global Counter Collection (Standardized Path: global_counter/main) ──
    match /global_counter/{docId} {
      allow read: if true;
      allow create, update: if true; // allow counter increments
      allow delete: if isAdmin();
    }

    // ── Counters Collection (Legacy Cleanup) ────────────────────
    match /counters/{docId} {
      allow read, write, delete: if isAdmin();
    }

    // ── User Profiles Collection (Strict User Data Privacy & Isolation) ──
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // ── User Daily Stats Subcollection (Strictly Isolated to Owner & Admin) ──
      match /daily_stats/{date} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // ── Any other user subcollections (Strictly Isolated to Owner & Admin) ──
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // ── Masail Q&A Collection ──────────────────────────────────
    match /masail_entries/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ── Aqaid Beliefs Collection ───────────────────────────────
    match /aqaid_entries/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ── Daily Content Collection ───────────────────────────────
    match /daily_content/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ── Community Events Collection ────────────────────────────
    match /events/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ── Broadcast Notifications Collection ─────────────────────
    match /notifications/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ── User Questions (Q&A) Collection ────────────────────────
    match /user_questions/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ── Password Reset OTPs Collection ──────────────────────────
    match /password_resets/{emailDoc} {
      allow read, write: if true;
    }

    // ── App Settings (Launch Popup, Global Configuration) ───────
    match /settings/{docId} {
      allow read, write: if true;
    }

    // ── Campaign Popups Collection ──────────────────────────────
    match /app_popups/{docId} {
      allow read, write: if true;
    }

    // ── App Configuration (FCM v1, Keys) ────────────────────────
    match /app_config/{docId} {
      allow read, write: if true;
    }
  }
}

